{
  "name": "raven",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "web",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"npm run dev -w @raven/web\" \"npm run dev -w @raven/server\"",
    "build": "npm run build -w @raven/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "husky",
    "db:generate": "npm run db:generate -w @raven/server",
    "db:migrate": "npm run db:migrate -w @raven/server",
    "db:studio": "npm run db:studio -w @raven/server"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "concurrently": "^10.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": "oxfmt --no-error-on-unmatched-pattern",
    "web/**/*.{ts,tsx}": "oxlint -c web/.oxlintrc.json"
  }
}
